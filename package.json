{
  "name": "slowpoke",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "prepare": "bash scripts/install-git-hooks.sh",
    "dev": "pnpm --filter @slowpoke/web dev",
    "build": "pnpm --filter @slowpoke/web build",
    "backend:dev": "cd apps/backend && uv run uvicorn slowpoke_backend:create_app --factory --reload --port 8000",
    "backend:test": "cd apps/backend && uv run pytest",
    "backend:test:database": "bash scripts/run-backend-database-tests.sh",
    "backend:test:e2e": "bash scripts/run-local-ingestion-e2e.sh",
    "backend:typecheck": "cd apps/backend && uv run pyright",
    "backend:lint": "cd apps/backend && uv run ruff check .",
    "backend:format": "cd apps/backend && uv run ruff format .",
    "backend:format:check": "cd apps/backend && uv run ruff format --check .",
    "db:reset": "supabase db reset --local",
    "db:test": "supabase test db",
    "db:types": "supabase gen types --lang=python --local --schema public > apps/backend/slowpoke_backend/database_types.py",
    "db:types:check": "bash scripts/check-python-db-types.sh",
    "check:metadata": "node scripts/check-metadata.mjs",
    "generate:wordmark": "pnpm --filter @slowpoke/web generate:wordmark",
    "start": "pnpm --filter @slowpoke/web start",
    "test:metadata": "node --test scripts/check-metadata.test.mjs",
    "typecheck": "pnpm --recursive typecheck && pnpm backend:typecheck",
    "lint": "oxlint --deny-warnings apps/web/src apps/web/scripts scripts apps/web/next.config.ts apps/web/postcss.config.mjs && pnpm backend:lint",
    "lint:fix": "oxlint --fix apps/web/src apps/web/scripts scripts apps/web/next.config.ts apps/web/postcss.config.mjs",
    "format": "oxfmt",
    "format:check": "oxfmt --check && pnpm backend:format:check"
  },
  "devDependencies": {
    "oxfmt": "^0.61.0",
    "oxlint": "^1.76.0",
    "supabase": "^2.110.0"
  },
  "engines": {
    "pnpm": "11.8.0"
  },
  "packageManager": "pnpm@11.8.0+sha512.c1f5e7c4cb241c8f174b743851d82f42b802324afc8b0f116b96adb15aa06664948dde36960a3ba1079ba5b4b29dd0140135b94b5b5f5263592249d68e555f26"
}
