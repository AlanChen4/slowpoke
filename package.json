{
  "name": "slowpoke",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "dev": "pnpm --filter @slowpoke/web dev",
    "build": "pnpm --filter @slowpoke/web build",
    "generate:wordmark": "pnpm --filter @slowpoke/web generate:wordmark",
    "start": "pnpm --filter @slowpoke/web start",
    "typecheck": "pnpm --recursive typecheck",
    "lint": "oxlint --deny-warnings apps/web/src apps/web/scripts packages/telemetry/src scripts apps/web/next.config.ts apps/web/postcss.config.mjs",
    "lint:fix": "oxlint --fix apps/web/src apps/web/scripts packages/telemetry/src scripts apps/web/next.config.ts apps/web/postcss.config.mjs",
    "format": "oxfmt",
    "format:check": "oxfmt --check"
  },
  "devDependencies": {
    "oxfmt": "^0.61.0",
    "oxlint": "^1.76.0",
    "supabase": "^2.110.0"
  },
  "engines": {
    "pnpm": "11.8.0"
  },
  "packageManager": "pnpm@11.8.0+sha512.c1f5e7c4cb241c8f174b743851d82f42b802324afc8b0f116b96adb15aa06664948dde36960a3ba1079ba5b4b29dd0140135b94b5b5f5263592249d68e555f26"
}
