{
  "name": "slowpoke",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "prepare": "bash scripts/install-git-hooks.sh",
    "setup:codex": "node scripts/setup-local-codex.mjs",
    "dev": "bash scripts/run-local-dev.sh",
    "build": "pnpm --filter @slowpoke/web build",
    "test": "node scripts/test.mjs",
    "test:e2e": "node scripts/test.mjs --suite e2e",
    "typecheck": "pnpm --filter @slowpoke/web typecheck && (cd apps/backend && uv run pyright)",
    "lint": "pnpm lint:js && pnpm lint:python",
    "lint:fix": "pnpm lint:js:fix && pnpm lint:python:fix",
    "lint:js": "oxlint --deny-warnings",
    "lint:js:fix": "oxlint --fix --deny-warnings",
    "lint:python": "cd apps/backend && uv run ruff check .",
    "lint:python:fix": "cd apps/backend && uv run ruff check --fix .",
    "format": "oxfmt && (cd apps/backend && uv run ruff format .)",
    "format:check": "oxfmt --check && (cd apps/backend && uv run ruff format --check .)",
    "db:reset": "bash scripts/reset-local-database.sh",
    "db:types": "supabase gen types --lang=python --local --schema public > apps/backend/slowpoke_backend/database_types.py",
    "check:metadata": "node scripts/check-metadata.mjs"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.78.0",
    "oxfmt": "^0.61.0",
    "oxlint": "1.78.0",
    "supabase": "^2.110.0"
  },
  "engines": {
    "pnpm": "11.8.0"
  },
  "packageManager": "pnpm@11.8.0+sha512.c1f5e7c4cb241c8f174b743851d82f42b802324afc8b0f116b96adb15aa06664948dde36960a3ba1079ba5b4b29dd0140135b94b5b5f5263592249d68e555f26"
}
