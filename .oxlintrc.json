{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error"
  },
  "plugins": ["node", "oxc", "typescript", "unicorn", "react", "jsx-a11y", "nextjs"],
  "ignorePatterns": [
    ".agent/**",
    ".agents/**",
    ".claude/**",
    ".codex/**",
    ".continue/**",
    ".cursor/**",
    ".gemini/**",
    ".opencode/**",
    ".pi/**",
    ".roo/**",
    ".windsurf/**",
    "tools/oxlint/anti-slop/**",
    "tools/oxlint/slowpoke-ui/**"
  ],
  "jsPlugins": [
    {
      "name": "anti-slop",
      "specifier": "./tools/oxlint/anti-slop/index.ts"
    },
    {
      "name": "slowpoke-ui",
      "specifier": "./tools/oxlint/slowpoke-ui/index.ts"
    }
  ],
  "options": {
    "reportUnusedDisableDirectives": "error"
  },
  "rules": {
    "anti-slop/no-chained-type-assertions": "error",
    "anti-slop/no-conditional-empty-object-spread": "error",
    "anti-slop/no-known-value-widening": "error",
    "anti-slop/no-module-mocking": "error",
    "anti-slop/no-object-parameters": "error",
    "anti-slop/no-reflect-apply": "error",
    "anti-slop/no-reflect-get": "error",
    "anti-slop/no-runtime-typeof": "error",
    "anti-slop/no-shape-in-symbol-names": "error",
    "anti-slop/no-unknown-parameters": "error",
    "anti-slop/no-unknown-returns": "error",
    "anti-slop/no-unknown-type-aliases": "error",
    "anti-slop/no-unsafe-dictionary-type": "error",
    "anti-slop/no-widen-then-assert": "error",
    "anti-slop/require-safety-comment-for-type-assertion": "error",
    "slowpoke-ui/heading-structure": "error",
    "slowpoke-ui/no-ornamental-border": "error",
    "node/no-process-env": "error",
    "react/forbid-elements": [
      "error",
      {
        "forbid": [
          {
            "element": "button",
            "message": "Use <Button /> from '@/components/ui/button'."
          },
          {
            "element": "input",
            "message": "Use <Input /> from '@/components/ui/input'."
          },
          {
            "element": "label",
            "message": "Use <Label /> from '@/components/ui/label'."
          },
          {
            "element": "hr",
            "message": "Use <Separator /> from '@/components/ui/separator'."
          },
          {
            "element": "fieldset",
            "message": "Use <FieldSet /> from '@/components/ui/field'."
          },
          {
            "element": "legend",
            "message": "Use <FieldLegend /> from '@/components/ui/field'."
          }
        ]
      }
    ],
    "react/react-compiler": "error"
  },
  "overrides": [
    {
      "files": ["apps/web/src/components/ui/**/*.{js,jsx,ts,tsx}"],
      "rules": {
        "react/forbid-elements": "off",
        "slowpoke-ui/no-ornamental-border": "off"
      }
    }
  ]
}
